# URL Backend REST API (Arahkan ke domain API production dengan HTTPS)
NEXT_PUBLIC_API_URL=https://api.quriva.tech/api

# Identitas & kontak resmi
NEXT_PUBLIC_COMPANY_NAME=PT Quriva Indonesia
NEXT_PUBLIC_ROOT_DOMAIN=quriva.tech
NEXT_PUBLIC_SUPPORT_WHATSAPP=6289614072349
NEXT_PUBLIC_SUPPORT_EMAIL=support@quriva.com

# Rekening pembayaran resmi
NEXT_PUBLIC_BANK_NAME=Bank Syariah Indonesia (BSI)
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER=7123456789
